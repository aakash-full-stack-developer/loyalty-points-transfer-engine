# Copy to .env and adjust. Every value here has a safe default for local development.
# Values below are for running the API on the host (`make run-local`). Inside Docker
# Compose, DATABASE_URL, REDIS_URL, PARTNER_BASE_URL and LOG_JSON are overridden with
# container hostnames (see docker-compose.yml).

# ---------------------------------------------------------------- Docker Compose
# PostgreSQL credentials used by the postgres container and to build DATABASE_URL in Compose.
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=loyalty
POSTGRES_DB=loyalty
# Host ports published by Compose. Change these if a port is already in use on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
SIMULATOR_HOST_PORT=8001

# ---------------------------------------------------------------- Application
# Deployment environment label, included in logs: local | docker | test | production.
ENVIRONMENT=local
# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# true = one JSON object per line (Docker/production); false = human-readable console output.
LOG_JSON=false

# ---------------------------------------------------------------- PostgreSQL
# SQLAlchemy async URL (asyncpg driver). PostgreSQL is the source of truth.
DATABASE_URL=postgresql+asyncpg://loyalty:loyalty@localhost:5432/loyalty
# Connections kept open in the pool per process.
DB_POOL_SIZE=10
# Extra connections allowed above DB_POOL_SIZE under burst load.
DB_MAX_OVERFLOW=5
# Seconds to wait for a free pooled connection before failing.
DB_POOL_TIMEOUT_SECONDS=5
# Server-side cap on any single SQL statement, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=5000
# Server-side cap on waiting for a row/table lock, in milliseconds.
DB_LOCK_TIMEOUT_MS=3000

# ---------------------------------------------------------------- Redis
# Used for idempotency locks, the rate cache and rate limiting. Never the source of truth.
REDIS_URL=redis://localhost:6379/0
# Socket connect/read timeout for Redis commands, in seconds.
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# ---------------------------------------------------------------- Partner APIs
# Base URL of the partner API (the partner simulator in development).
PARTNER_BASE_URL=http://localhost:8001
# Seconds to establish a TCP connection to a partner.
PARTNER_CONNECT_TIMEOUT_SECONDS=1.0
# Seconds to wait for a partner response once the request is sent.
PARTNER_READ_TIMEOUT_SECONDS=3.0
# Total attempts per partner call (1 = no retries). Only retryable outcomes are retried.
PARTNER_RETRY_MAX_ATTEMPTS=3
# Exponential backoff base delay between retries, in milliseconds (full jitter applied).
PARTNER_RETRY_BASE_DELAY_MS=100
# Upper bound for a single backoff delay, in milliseconds.
PARTNER_RETRY_MAX_DELAY_MS=1000
# Overall budget for one partner call including all retries, in seconds.
PARTNER_TOTAL_DEADLINE_SECONDS=8.0
# Consecutive failures that open a partner's circuit breaker.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Seconds an open circuit waits before allowing a trial (half-open) request.
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------- Rate limiting
# Maximum POST /v1/transfers requests per user per window.
RATE_LIMIT_TRANSFERS_PER_WINDOW=30
# Fixed window length, in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- Idempotency and caching
# How long an Idempotency-Key is remembered, in seconds (24 hours).
IDEMPOTENCY_TTL_SECONDS=86400
# TTL of the Redis lock held while a request with a given key is in progress, in milliseconds.
IDEMPOTENCY_LOCK_TTL_MS=30000
# TTL of cached active rates in Redis, in seconds (also invalidated on every rate change).
RATE_CACHE_TTL_SECONDS=60
# How long a quote is presented as valid (expires_at), in seconds. Informational for clients.
QUOTE_TTL_SECONDS=60

# ---------------------------------------------------------------- Security
# Shared secret required in the X-Admin-Key header for /v1/admin/* endpoints. Change it.
ADMIN_API_KEY=change-me-admin-key

# ---------------------------------------------------------------- Reconciliation
# Seconds after an unknown partner outcome before the reconciler first checks the partner.
RECONCILIATION_INITIAL_DELAY_SECONDS=10

# ---------------------------------------------------------------- Health checks
# Seconds each readiness dependency check (PostgreSQL, Redis) may take.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
